<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F3F6FC"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/btnQuayLaiChiTiet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="‹  Chi tiết phụ tùng"
            android:textColor="#17212F"
            android:textSize="21sp"
            android:textStyle="bold"
            android:paddingVertical="10dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="#FFFFFF"
            android:elevation="3dp">

            <ImageView
                android:id="@+id/imgChiTietPhuTung"
                android:layout_width="match_parent"
                android:layout_height="250dp"
                android:scaleType="fitCenter"
                android:contentDescription="Ảnh phụ tùng"
                android:src="@android:drawable/ic_menu_gallery" />

            <TextView
                android:id="@+id/txtChiTietTen"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Tên phụ tùng"
                android:textColor="#17212F"
                android:textSize="23sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtChiTietGia"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="495.000 VNĐ"
                android:textColor="#1565C0"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtChiTietTrangThai"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Còn hàng"
                android:textColor="#2E7D32"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtChiTietSoLuong"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Còn 20 sản phẩm"
                android:textColor="#64748B"
                android:textSize="14sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Mô tả sản phẩm"
                android:textColor="#17212F"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtChiTietMoTa"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Thông tin chi tiết phụ tùng"
                android:textColor="#64748B"
                android:textSize="14sp"
                android:lineSpacingExtra="4dp" />


        </LinearLayout>

    </LinearLayout>
</ScrollView>
