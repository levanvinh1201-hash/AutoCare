<?xml version="1.0" encoding="utf-8"?>

<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="14dp"
    app:cardCornerRadius="18dp"
    app:cardElevation="3dp"
    app:cardBackgroundColor="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <!-- TÊN DỊCH VỤ + TRẠNG THÁI -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:gravity="center"
                android:text="🔧"
                android:textSize="22sp"
                android:background="#E8F1FF"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="10dp">

                <TextView
                    android:id="@+id/txtTenDichVu"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Thay dầu nhớt"
                    android:textColor="#1F2937"
                    android:textSize="17sp"
                    android:textStyle="bold"/>

            </LinearLayout>

            <TextView
                android:id="@+id/txtTrangThai"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Chờ xác nhận"
                android:textColor="#F59E0B"
                android:textSize="11sp"
                android:textStyle="bold"
                android:paddingStart="9dp"
                android:paddingEnd="9dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:background="#FFF4D6"/>

        </LinearLayout>


        <!-- ĐƯỜNG KẺ -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#EEF1F5"
            android:layout_marginTop="15dp"
            android:layout_marginBottom="14dp"/>


        <!-- THÔNG TIN XE -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="35dp"
                android:layout_height="35dp"
                android:gravity="center"
                android:text="🚗"
                android:textSize="19sp"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Xe của bạn"
                    android:textColor="#9CA3AF"
                    android:textSize="11sp"/>

                <TextView
                    android:id="@+id/txtThongTinXe"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Toyota Vios - 99A-12345"
                    android:textColor="#374151"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginTop="2dp"/>

            </LinearLayout>

        </LinearLayout>


        <!-- NGÀY + GIỜ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="14dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="35dp"
                    android:layout_height="35dp"
                    android:gravity="center"
                    android:text="📅"
                    android:textSize="18sp"/>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ngày hẹn"
                        android:textColor="#9CA3AF"
                        android:textSize="11sp"/>

                    <TextView
                        android:id="@+id/txtNgay"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="24/09/2026"
                        android:textColor="#374151"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:layout_marginTop="2dp"/>

                </LinearLayout>

            </LinearLayout>


            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="35dp"
                    android:layout_height="35dp"
                    android:gravity="center"
                    android:text="🕐"
                    android:textSize="18sp"/>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Giờ hẹn"
                        android:textColor="#9CA3AF"
                        android:textSize="11sp"/>

                    <TextView
                        android:id="@+id/txtGio"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="18:45"
                        android:textColor="#374151"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:layout_marginTop="2dp"/>

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>


        <!-- GHI CHÚ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="14dp"
            android:padding="10dp"
            android:background="#F8FAFC">

            <TextView
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:gravity="center"
                android:text="📝"
                android:textSize="16sp"/>

            <TextView
                android:id="@+id/txtGhiChu"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="thay lốp"
                android:textColor="#6B7280"
                android:textSize="13sp"
                android:layout_marginStart="6dp"/>
            <Button
                android:id="@+id/btnHuyLich"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="14dp"
                android:text="Hủy lịch"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#DC2626"
                android:backgroundTint="#FEE2E2"/>

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>