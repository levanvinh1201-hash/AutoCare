<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="#FFFFFF">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="📞 Bổ sung số điện thoại"
        android:textColor="#1565C0"
        android:textSize="21sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Vui lòng cung cấp số điện thoại để AutoCare có thể liên hệ xác nhận lịch hẹn và hỗ trợ bạn khi cần thiết."
        android:textColor="#64748B"
        android:textSize="14sp"
        android:lineSpacingExtra="4dp" />

    <EditText
        android:id="@+id/edtSoDienThoai"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginTop="22dp"
        android:background="@drawable/bg_register_input"
        android:hint="Nhập số điện thoại của bạn"
        android:inputType="phone"
        android:maxLength="10"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:singleLine="true"
        android:textColor="#172B4D"
        android:textColorHint="#94A3B8"
        android:textSize="15sp" />

    <Button
        android:id="@+id/btnLuuSoDienThoai"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="22dp"
        android:backgroundTint="#1976D2"
        android:text="Lưu và tiếp tục"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:textStyle="bold" />

</LinearLayout>