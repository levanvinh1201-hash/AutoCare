<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F4F7FC">

    <!-- NỘI DUNG CUỘN -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- HEADER -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="175dp"
                android:orientation="vertical"
                android:gravity="bottom"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:paddingTop="28dp"
                android:paddingBottom="30dp"
                android:background="#123B92">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="AUTOCARE  /  ĐẶT LỊCH"
                    android:textColor="#BBD6FF"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.12"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Đặt lịch sửa xe"
                    android:textColor="#FFFFFF"
                    android:textSize="29sp"
                    android:textStyle="bold"
                    android:layout_marginTop="12dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Chọn dịch vụ và thời gian phù hợp với bạn"
                    android:textColor="#DCEBFF"
                    android:textSize="14sp"
                    android:layout_marginTop="6dp"/>

            </LinearLayout>

            <!-- PHẦN FORM -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- THẺ FORM -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="3dp"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardUseCompatPadding="true">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="18dp">

                        <!-- TIÊU ĐỀ -->
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Thông tin đặt lịch"
                            android:textColor="#14264B"
                            android:textSize="20sp"
                            android:textStyle="bold"/>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Vui lòng điền đầy đủ thông tin bên dưới"
                            android:textColor="#8490A5"
                            android:textSize="13sp"
                            android:layout_marginTop="5dp"
                            android:layout_marginBottom="24dp"/>

                        <!-- CHỌN XE -->
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="01   Xe cần sửa chữa"
                            android:textColor="#243B63"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="9dp"/>

                        <Spinner
                            android:id="@+id/spinnerXe"
                            android:layout_width="match_parent"
                            android:layout_height="54dp"
                            android:background="@drawable/bg_dat_lich_input"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp"
                            android:spinnerMode="dropdown"
                            android:layout_marginBottom="22dp"/>

                        <!-- DỊCH VỤ -->
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="02   Dịch vụ bảo dưỡng / sửa chữa"
                            android:textColor="#243B63"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="9dp"/>

                        <Spinner
                            android:id="@+id/spinnerDichVu"
                            android:layout_width="match_parent"
                            android:layout_height="54dp"
                            android:background="@drawable/bg_dat_lich_input"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp"
                            android:spinnerMode="dropdown"
                            android:layout_marginBottom="22dp"/>

                        <!-- THỜI GIAN -->
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="03   Thời gian hẹn"
                            android:textColor="#243B63"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="12dp"/>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:baselineAligned="false"
                            android:layout_marginBottom="22dp">

                            <!-- NGÀY -->
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:layout_marginEnd="6dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Ngày hẹn"
                                    android:textSize="13sp"
                                    android:textColor="#64748B"
                                    android:layout_marginBottom="8dp"/>

                                <Button
                                    android:id="@+id/btnChonNgay"
                                    android:layout_width="match_parent"
                                    android:layout_height="54dp"
                                    android:text="Chọn ngày"
                                    android:textAllCaps="false"
                                    android:textSize="13sp"
                                    android:textColor="#243B63"
                                    android:background="@drawable/bg_dat_lich_input"
                                    android:backgroundTint="@null"
                                    android:paddingStart="4dp"
                                    android:paddingEnd="4dp"/>

                            </LinearLayout>

                            <!-- GIỜ -->
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:layout_marginStart="6dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Giờ hẹn"
                                    android:textSize="13sp"
                                    android:textColor="#64748B"
                                    android:layout_marginBottom="8dp"/>

                                <Button
                                    android:id="@+id/btnChonGio"
                                    android:layout_width="match_parent"
                                    android:layout_height="54dp"
                                    android:text="Chọn giờ"
                                    android:textAllCaps="false"
                                    android:textSize="13sp"
                                    android:textColor="#243B63"
                                    android:background="@drawable/bg_dat_lich_input"
                                    android:backgroundTint="@null"
                                    android:paddingStart="4dp"
                                    android:paddingEnd="4dp"/>

                            </LinearLayout>

                        </LinearLayout>

                        <!-- GHI CHÚ -->
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="04   Ghi chú thêm"
                            android:textColor="#243B63"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="9dp"/>

                        <EditText
                            android:id="@+id/edtGhiChu"
                            android:layout_width="match_parent"
                            android:layout_height="112dp"
                            android:hint="Mô tả tình trạng xe hoặc yêu cầu khác..."
                            android:gravity="top|start"
                            android:padding="14dp"
                            android:textSize="14sp"
                            android:textColor="#243B63"
                            android:textColorHint="#9AA7B8"
                            android:inputType="textMultiLine"
                            android:background="@drawable/bg_dat_lich_input"
                            android:layout_marginBottom="24dp"/>

                        <!-- NÚT XÁC NHẬN -->
                        <Button
                            android:id="@+id/btnXacNhanDatLich"
                            android:layout_width="match_parent"
                            android:layout_height="58dp"
                            android:text="Xác nhận đặt lịch   →"
                            android:textAllCaps="false"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="#FFFFFF"
                            android:background="@drawable/bg_dat_lich_button"
                            android:backgroundTint="@null"
                            android:elevation="2dp"/>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Lịch hẹn sẽ được xác nhận sau khi gara tiếp nhận yêu cầu."
                            android:textColor="#8490A5"
                            android:textSize="12sp"
                            android:gravity="center"
                            android:layout_marginTop="14dp"/>

                    </LinearLayout>

                </androidx.cardview.widget.CardView>

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

    <!-- THANH ĐIỀU HƯỚNG CỐ ĐỊNH -->
    <include
        layout="@layout/layout_bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

</LinearLayout>