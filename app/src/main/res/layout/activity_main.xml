<?xml version="1.0" encoding="utf-8"?>

<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <!-- Ảnh nền -->
    <ImageView
        android:id="@+id/ivMainCar"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/main_car"
        android:scaleType="centerCrop"
        android:alpha="0.65"
        android:contentDescription="Ảnh nền AutoCare" />

    <!-- Nội dung hiển thị đè lên ảnh nền -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp">

        <!-- Tên ứng dụng -->
        <TextView
            android:id="@+id/tvAppName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="AUTOCARE"
            android:textSize="50sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif"
            android:textColor="#000055"
            android:gravity="center" />

        <!-- Khẩu hiệu -->
        <TextView
            android:id="@+id/tvSlogan"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Chăm sóc xe hơi của bạn"
            android:textSize="25sp"
            android:fontFamily="sans-serif"
            android:textColor="#000088"
            android:gravity="center" />

    </LinearLayout>

</FrameLayout>
