<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="#FFFFFF">

    <!-- Tiêu đề -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Thêm xe mới"
        android:textSize="26sp"
        android:textStyle="bold"
        android:textColor="#172033"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Nhập thông tin phương tiện của bạn"
        android:textSize="14sp"
        android:textColor="#7A8499"
        android:layout_marginTop="5dp"
        android:layout_marginBottom="22dp"/>


    <!-- Hãng xe -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Hãng xe"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="#374151"
        android:layout_marginBottom="6dp"/>

    <EditText
        android:id="@+id/edtHangXe"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:hint="Ví dụ: Toyota"
        android:textSize="15sp"
        android:singleLine="true"
        android:inputType="text"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:background="#F3F6FA"
        android:layout_marginBottom="14dp"/>


    <!-- Tên xe -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Tên xe / dòng xe"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="#374151"
        android:layout_marginBottom="6dp"/>

    <EditText
        android:id="@+id/edtTenXe"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:hint="Ví dụ: Vios"
        android:textSize="15sp"
        android:singleLine="true"
        android:inputType="text"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:background="#F3F6FA"
        android:layout_marginBottom="14dp"/>


    <!-- Biển số -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Biển số xe"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="#374151"
        android:layout_marginBottom="6dp"/>

    <EditText
        android:id="@+id/edtBienSo"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:hint="Ví dụ: 99A-123.45"
        android:textSize="15sp"
        android:singleLine="true"
        android:inputType="textCapCharacters"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:background="#F3F6FA"
        android:layout_marginBottom="14dp"/>


    <!-- Năm sản xuất -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Năm sản xuất"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="#374151"
        android:layout_marginBottom="6dp"/>

    <EditText
        android:id="@+id/edtNamSanXuat"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:hint="Ví dụ: 2022"
        android:textSize="15sp"
        android:singleLine="true"
        android:inputType="number"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:background="#F3F6FA"
        android:layout_marginBottom="22dp"/>


    <!-- Nút lưu -->
    <Button
        android:id="@+id/btnLuuXe"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:text="Lưu thông tin xe"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:backgroundTint="#1565C0"
        android:elevation="3dp"/>

</LinearLayout>