<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true"
    android:background="#FFFFFF"
    android:scrollbars="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="22dp">

        <!-- TIÊU ĐỀ -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Thêm xe mới"
            android:textSize="25sp"
            android:textStyle="bold"
            android:textColor="#14264B" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Cập nhật thông tin phương tiện của bạn"
            android:textSize="13sp"
            android:textColor="#7A8499"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="20dp" />

        <!-- TIÊU ĐỀ ẢNH XE -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Hình ảnh phương tiện"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#374151"
            android:layout_marginBottom="10dp" />

        <!-- KHUNG HIỂN THỊ ẢNH -->
        <ImageView
            android:id="@+id/imgAnhXe"
            android:layout_width="match_parent"
            android:layout_height="175dp"
            android:background="#EAF1FB"
            android:scaleType="centerCrop"
            android:contentDescription="Ảnh xe được chọn" />

        <!-- NÚT CHỌN ẢNH -->
        <Button
            android:id="@+id/btnChonAnhXe"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="22dp"
            android:text="Chọn ảnh từ thư viện"
            android:textAllCaps="false"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#1565C0"
            android:backgroundTint="#E8F0FE" />

        <!-- THÔNG TIN XE -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Thông tin phương tiện"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#14264B"
            android:layout_marginBottom="18dp" />

        <!-- HÃNG XE -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Hãng xe"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#374151"
            android:layout_marginBottom="6dp" />

        <EditText
            android:id="@+id/edtHangXe"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:hint="Ví dụ: Toyota"
            android:textSize="15sp"
            android:textColor="#172033"
            android:textColorHint="#9AA7B8"
            android:singleLine="true"
            android:inputType="text"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:background="#F3F6FA"
            android:layout_marginBottom="16dp" />

        <!-- TÊN XE -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tên xe / dòng xe"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#374151"
            android:layout_marginBottom="6dp" />

        <EditText
            android:id="@+id/edtTenXe"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:hint="Ví dụ: Vios"
            android:textSize="15sp"
            android:textColor="#172033"
            android:textColorHint="#9AA7B8"
            android:singleLine="true"
            android:inputType="text"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:background="#F3F6FA"
            android:layout_marginBottom="16dp" />

        <!-- BIỂN SỐ -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Biển số xe"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#374151"
            android:layout_marginBottom="6dp" />

        <EditText
            android:id="@+id/edtBienSo"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:hint="Ví dụ: 99A-123.45"
            android:textSize="15sp"
            android:textColor="#172033"
            android:textColorHint="#9AA7B8"
            android:singleLine="true"
            android:inputType="textCapCharacters"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:background="#F3F6FA"
            android:layout_marginBottom="16dp" />

        <!-- NĂM SẢN XUẤT -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Năm sản xuất"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#374151"
            android:layout_marginBottom="6dp" />

        <EditText
            android:id="@+id/edtNamSanXuat"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:hint="Ví dụ: 2022"
            android:textSize="15sp"
            android:textColor="#172033"
            android:textColorHint="#9AA7B8"
            android:singleLine="true"
            android:inputType="number"
            android:maxLength="4"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:background="#F3F6FA"
            android:layout_marginBottom="24dp" />

        <!-- NÚT LƯU -->
        <Button
            android:id="@+id/btnLuuXe"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Lưu thông tin xe"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#1565C0"
            android:elevation="3dp" />

    </LinearLayout>

</ScrollView>