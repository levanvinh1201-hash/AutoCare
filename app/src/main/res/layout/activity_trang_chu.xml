<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F7FC">

    <!-- NỘI DUNG CUỘN -->
    <ScrollView
        android:id="@+id/scrollTrangChu"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingLeft="18dp"
            android:paddingRight="18dp"
            android:paddingTop="22dp"
            android:paddingBottom="28dp">

            <!-- HEADER -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="20dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="AutoCare"
                        android:textColor="#1258A8"
                        android:textSize="30sp"
                        android:textStyle="bold"
                        android:includeFontPadding="false" />

                    <TextView
                        android:id="@+id/tvXinChao"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Xin chào!"
                        android:textColor="#475569"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:maxLines="2" />

                </LinearLayout>

                <TextView
                    android:id="@+id/tvAvatar"
                    android:layout_width="54dp"
                    android:layout_height="54dp"
                    android:layout_marginStart="12dp"
                    android:background="@drawable/bg_home_avatar"
                    android:gravity="center"
                    android:text="👤"
                    android:textSize="29sp" />

            </LinearLayout>

            <!-- BANNER -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="160dp"
                android:background="@drawable/bg_home_banner"
                android:orientation="vertical"
                android:padding="18dp"
                android:elevation="3dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="70dp"
                        android:layout_height="70dp"
                        android:gravity="center"
                        android:text="🚗"
                        android:textSize="45sp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="10dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Chăm sóc xe"
                            android:textColor="#FFFFFF"
                            android:textSize="23sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="Đặt lịch bảo dưỡng nhanh chóng"
                            android:textColor="#EAF3FF"
                            android:textSize="13sp" />

                    </LinearLayout>

                </LinearLayout>

                <Button
                    android:id="@+id/btnDatLich"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_gravity="end"
                    android:layout_marginTop="8dp"
                    android:backgroundTint="#FFFFFF"
                    android:text="📅  Đặt lịch ngay"
                    android:textAllCaps="false"
                    android:textColor="#1258A8"
                    android:textSize="14sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- PHỤ TÙNG -->
            <LinearLayout
                android:id="@+id/sectionPhuTung"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:orientation="vertical"
                android:focusable="true"
                android:focusableInTouchMode="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Phụ tùng ô tô"
                        android:textColor="#17212F"
                        android:textSize="21sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Xem tất cả  ›"
                        android:textColor="#1565C0"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="Các phụ tùng đang có tại gara"
                    android:textColor="#64748B"
                    android:textSize="13sp" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerPhuTung"
                    android:layout_width="match_parent"
                    android:layout_height="235dp"
                    android:layout_marginTop="14dp"
                    android:clipToPadding="false"
                    android:paddingEnd="6dp"
                    android:scrollbars="none" />

            </LinearLayout>

            <!-- TIỆN ÍCH -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="25dp"
                android:text="Tiện ích"
                android:textColor="#17212F"
                android:textSize="21sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <Button
                    android:id="@+id/btnXeCuaToi"
                    android:layout_width="0dp"
                    android:layout_height="72dp"
                    android:layout_weight="1"
                    android:backgroundTint="#FFFFFF"
                    android:text="🚗\nXe của tôi"
                    android:textAllCaps="false"
                    android:textColor="#1258A8"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:padding="3dp" />

                <Button
                    android:id="@+id/btnLichSu"
                    android:layout_width="0dp"
                    android:layout_height="72dp"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:backgroundTint="#FFFFFF"
                    android:text="📋\nLịch sử đặt lịch"
                    android:textAllCaps="false"
                    android:textColor="#1258A8"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:padding="3dp" />

                <Button
                    android:id="@+id/btnDangXuat"
                    android:layout_width="0dp"
                    android:layout_height="72dp"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:backgroundTint="#FFFFFF"
                    android:text="🚪\nĐăng xuất"
                    android:textAllCaps="false"
                    android:textColor="#C62828"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:padding="3dp" />

            </LinearLayout>

            <!-- DỊCH VỤ -->
            <LinearLayout
                android:id="@+id/sectionDichVu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="27dp"
                android:orientation="vertical"
                android:focusable="true"
                android:focusableInTouchMode="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:text="Dịch vụ phổ biến"
                        android:textColor="#17212F"
                        android:textSize="21sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Xem tất cả  ›"
                        android:textColor="#1565C0"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="Dịch vụ chăm sóc và bảo dưỡng xe"
                    android:textColor="#64748B"
                    android:textSize="13sp" />

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:scrollbars="none"
                    android:clipToPadding="false">

                    <LinearLayout
                        android:id="@+id/layoutDichVu"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingBottom="6dp" />

                </HorizontalScrollView>

            </LinearLayout>

        </LinearLayout>

    </ScrollView>




    <!-- THANH ĐIỀU HƯỚNG CHÍNH -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="76dp"
        android:layout_marginLeft="10dp"
        android:layout_marginRight="10dp"
        android:layout_marginBottom="8dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="@drawable/bg_home_bottom_nav"
        android:elevation="10dp">

        <!-- TRANG CHỦ -->
        <LinearLayout
            android:id="@+id/btnNavTrangChu"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/bg_home_nav_item">

            <ImageView
                android:layout_width="27dp"
                android:layout_height="27dp"
                android:src="@drawable/tc_trangchu"
                android:scaleType="fitCenter"
                android:contentDescription="Trang chủ" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Trang chủ"
                android:textColor="#FFFFFF"
                android:textSize="10sp" />

        </LinearLayout>

        <!-- ĐẶT LỊCH -->
        <LinearLayout
            android:id="@+id/btnNavLich"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/bg_home_nav_item">

            <ImageView
                android:layout_width="27dp"
                android:layout_height="27dp"
                android:src="@drawable/tc_datlich"
                android:scaleType="fitCenter"
                android:contentDescription="Đặt lịch" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Đặt lịch"
                android:textColor="#FFFFFF"
                android:textSize="10sp" />

        </LinearLayout>

        <!-- XE CỦA TÔI -->
        <LinearLayout
            android:id="@+id/btnNavXeCuaToi"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/bg_home_nav_item">

            <ImageView
                android:layout_width="27dp"
                android:layout_height="27dp"
                android:src="@drawable/tc_xe"
                android:scaleType="fitCenter"
                android:contentDescription="Xe của tôi" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Xe của tôi"
                android:textColor="#FFFFFF"
                android:textSize="10sp" />

        </LinearLayout>

        <!-- ĐẠI LÝ -->
        <LinearLayout
            android:id="@+id/btnNavDaiLy"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/bg_home_nav_item">

            <ImageView
                android:layout_width="27dp"
                android:layout_height="27dp"
                android:src="@drawable/tc_daily"
                android:scaleType="fitCenter"
                android:contentDescription="Đại lý" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Đại lý"
                android:textColor="#FFFFFF"
                android:textSize="10sp" />

        </LinearLayout>

        <!-- TÀI KHOẢN -->
        <LinearLayout
            android:id="@+id/btnNavTaiKhoan"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/bg_home_nav_item">

            <ImageView
                android:layout_width="27dp"
                android:layout_height="27dp"
                android:src="@drawable/tc_taikhoan"
                android:scaleType="fitCenter"
                android:contentDescription="Tài khoản" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Tài khoản"
                android:textColor="#FFFFFF"
                android:textSize="10sp" />

        </LinearLayout>



</LinearLayout>

</LinearLayout>
