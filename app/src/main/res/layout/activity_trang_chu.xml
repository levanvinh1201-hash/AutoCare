<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F7FA">

    <!-- ========================= -->
    <!-- PHẦN NỘI DUNG CUỘN -->
    <!-- ========================= -->

    <ScrollView
        android:id="@+id/scrollTrangChu"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:background="#F5F7FA">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:paddingBottom="30dp">

            <!-- ========================= -->
            <!-- HEADER -->
            <!-- ========================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingBottom="18dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="AutoCare"
                        android:textSize="26sp"
                        android:textStyle="bold"
                        android:textColor="#1565C0" />

                    <TextView
                        android:id="@+id/tvXinChao"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Xin chào!"
                        android:textSize="15sp"
                        android:textColor="#555555" />

                </LinearLayout>

                <TextView
                    android:id="@+id/tvAvatar"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:gravity="center"
                    android:text="👤"
                    android:textSize="28sp"
                    android:background="#E3F2FD" />

            </LinearLayout>

            <!-- ========================= -->
            <!-- BANNER -->
            <!-- ========================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="145dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="20dp"
                android:background="#1976D2">

                <TextView
                    android:layout_width="65dp"
                    android:layout_height="65dp"
                    android:gravity="center"
                    android:text="🚗"
                    android:textSize="42sp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="14dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Chăm sóc xe"
                        android:textColor="#FFFFFF"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Đặt lịch bảo dưỡng nhanh chóng"
                        android:textColor="#E3F2FD"
                        android:textSize="14sp" />

                </LinearLayout>

            </LinearLayout>

            <!-- ========================= -->
            <!-- ĐẶT LỊCH -->
            <!-- ========================= -->

            <Button
                android:id="@+id/btnDatLich"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginTop="18dp"
                android:text="📅  Đặt lịch ngay"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:backgroundTint="#1565C0" />

            <!-- ========================= -->
            <!-- DỊCH VỤ -->
            <!-- ========================= -->

            <LinearLayout
                android:id="@+id/sectionDichVu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:layout_marginTop="26dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Dịch vụ phổ biến"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="#222222" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Chọn dịch vụ để đặt lịch nhanh"
                    android:textSize="13sp"
                    android:textColor="#777777" />

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/layoutDichVu"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />

                </HorizontalScrollView>

            </LinearLayout>

            <!-- ========================= -->
            <!-- PHỤ TÙNG -->
            <!-- ========================= -->

            <LinearLayout
                android:id="@+id/sectionPhuTung"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:layout_marginTop="28dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Phụ tùng ô tô"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="#222222" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Các phụ tùng đang có tại gara"
                    android:textSize="13sp"
                    android:textColor="#777777" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerPhuTung"
                    android:layout_width="match_parent"
                    android:layout_height="225dp"
                    android:layout_marginTop="12dp"
                    android:clipToPadding="false"
                    android:paddingEnd="8dp" />

            </LinearLayout>

            <!-- ========================= -->
            <!-- TIỆN ÍCH -->
            <!-- ========================= -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="Tiện ích"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#222222" />

            <Button
                android:id="@+id/btnXeCuaToi"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="12dp"
                android:text="🚗  Xe của tôi"
                android:textSize="15sp"
                android:backgroundTint="#FFFFFF"
                android:textColor="#1565C0" />

            <Button
                android:id="@+id/btnLichSu"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:text="📋  Lịch sử đặt lịch"
                android:textSize="15sp"
                android:backgroundTint="#FFFFFF"
                android:textColor="#1565C0" />


            <Button
                android:id="@+id/btnDangXuat"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:text="🚪  Đăng xuất"
                android:textSize="15sp"
                android:backgroundTint="#FFFFFF"
                android:textColor="#D32F2F" />

        </LinearLayout>

    </ScrollView>

    <!-- ========================= -->
    <!-- TASKBAR CỐ ĐỊNH -->
    <!-- ========================= -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="#1D0E37"
        android:elevation="12dp">

        <!-- LỊCH -->

        <LinearLayout
            android:id="@+id/btnNavLich"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📅"
                android:textSize="23sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Đặt lịch"
                android:textSize="11sp"
                android:textColor="#555555" />

        </LinearLayout>

        <!-- DỊCH VỤ -->

        <LinearLayout
            android:id="@+id/btnNavDichVu"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔧"
                android:textSize="23sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Dịch vụ"
                android:textSize="11sp"
                android:textColor="#555555" />

        </LinearLayout>

        <!-- PHỤ TÙNG -->

        <LinearLayout
            android:id="@+id/btnNavPhuTung"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚙️"
                android:textSize="23sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Phụ tùng"
                android:textSize="11sp"
                android:textColor="#555555" />

        </LinearLayout>

        <!-- TÀI KHOẢN -->

        <LinearLayout
            android:id="@+id/btnNavTaiKhoan"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="👤"
                android:textSize="23sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tài khoản"
                android:textSize="11sp"
                android:textColor="#555555" />

        </LinearLayout>

        </LinearLayout>


    </LinearLayout>
