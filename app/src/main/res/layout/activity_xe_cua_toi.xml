<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F4F7FC">

    <!-- NỘI DUNG CUỘN -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- HEADER -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="175dp"
                android:orientation="vertical"
                android:gravity="bottom"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:paddingTop="28dp"
                android:paddingBottom="30dp"
                android:background="#123B92">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="AUTOCARE  /  PHƯƠNG TIỆN"
                    android:textColor="#BBD6FF"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.12"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Xe của tôi"
                    android:textColor="#FFFFFF"
                    android:textSize="29sp"
                    android:textStyle="bold"
                    android:layout_marginTop="12dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Quản lý phương tiện nhanh chóng và dễ dàng"
                    android:textColor="#DCEBFF"
                    android:textSize="14sp"
                    android:layout_marginTop="6dp"/>

            </LinearLayout>

            <!-- NỘI DUNG CHÍNH -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- THẺ THỐNG KÊ -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="3dp"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardUseCompatPadding="true">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="20dp">

                        <!-- BIỂU TƯỢNG -->
                        <TextView
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            android:gravity="center"
                            android:text="🚗"
                            android:textSize="30sp"
                            android:background="#E8F0FE"/>

                        <!-- THÔNG TIN -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="16dp">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Phương tiện của bạn"
                                android:textColor="#64748B"
                                android:textSize="14sp"/>

                            <TextView
                                android:id="@+id/tvSoLuongXe"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="0 xe"
                                android:textColor="#123B92"
                                android:textSize="26sp"
                                android:textStyle="bold"
                                android:layout_marginTop="4dp"/>

                        </LinearLayout>

                    </LinearLayout>

                </androidx.cardview.widget.CardView>

                <!-- NÚT THÊM XE -->
                <Button
                    android:id="@+id/btnThemXe"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="16dp"
                    android:text="+  Thêm xe mới"
                    android:textAllCaps="false"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/bg_xe_button"
                    android:backgroundTint="@null"
                    android:elevation="3dp"/>

                <!-- TIÊU ĐỀ DANH SÁCH -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="28dp"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Danh sách xe"
                        android:textColor="#14264B"
                        android:textSize="20sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Đã đăng ký"
                        android:textColor="#1565C0"
                        android:textSize="12sp"
                        android:padding="6dp"
                        android:background="#E8F0FE"/>

                </LinearLayout>

                <!-- TRẠNG THÁI CHƯA CÓ XE -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/layoutKhongCoXe"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardUseCompatPadding="true">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="28dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🚙"
                            android:textSize="48sp"
                            android:layout_marginBottom="12dp"/>

                        <TextView
                            android:id="@+id/tvKhongCoXe"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Chưa có phương tiện"
                            android:textColor="#14264B"
                            android:textSize="18sp"
                            android:textStyle="bold"/>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Thêm phương tiện đầu tiên để dễ dàng đặt lịch bảo dưỡng và sửa chữa."
                            android:textColor="#8490A5"
                            android:textSize="14sp"
                            android:gravity="center"
                            android:layout_marginTop="8dp"/>

                    </LinearLayout>

                </androidx.cardview.widget.CardView>

                <!-- DANH SÁCH XE -->
                <LinearLayout
                    android:id="@+id/layoutDanhSachXe"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="20dp"/>

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

    <!-- THANH ĐIỀU HƯỚNG CỐ ĐỊNH -->
    <include
        layout="@layout/layout_bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

</LinearLayout>