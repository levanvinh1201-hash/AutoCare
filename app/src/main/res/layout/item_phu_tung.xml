<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="180dp"
    android:layout_height="210dp"
    android:layout_marginEnd="12dp"
    android:orientation="vertical"
    android:padding="10dp"
    android:background="#FFFFFF"
    android:elevation="3dp">

    <ImageView
        android:id="@+id/imgPhuTung"
        android:layout_width="match_parent"
        android:layout_height="90dp"
        android:scaleType="centerInside"
        android:src="@android:drawable/ic_menu_gallery" />

    <TextView
        android:id="@+id/txtTenPhuTung"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Dầu nhớt Castrol"
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="#222222"
        android:maxLines="2" />

    <TextView
        android:id="@+id/txtGiaPhuTung"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="450000 VNĐ"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="#1565C0" />

    <TextView
        android:id="@+id/txtSoLuongPhuTung"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:text="Còn 20 sản phẩm"
        android:textSize="12sp"
        android:textColor="#666666" />

    <TextView
        android:id="@+id/txtTrangThaiPhuTung"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:text="Còn hàng"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="#2E7D32" />

</LinearLayout>