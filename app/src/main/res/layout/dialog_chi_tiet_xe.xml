<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#FFFFFF"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- TIÊU ĐỀ -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Chi tiết phương tiện"
            android:textSize="23sp"
            android:textStyle="bold"
            android:textColor="#14264B" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Thông tin phương tiện đã đăng ký"
            android:textSize="13sp"
            android:textColor="#8490A5"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="18dp" />

        <!-- ẢNH XE -->
        <ImageView
            android:id="@+id/imgChiTietXe"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:background="#EAF1FB"
            android:scaleType="centerCrop"
            android:contentDescription="Hình ảnh phương tiện" />

        <!-- TÊN XE -->
        <TextView
            android:id="@+id/tvChiTietTenXe"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Toyota Vios"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#14264B"
            android:layout_marginTop="18dp" />

        <!-- HÃNG XE -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Hãng xe"
            android:textSize="13sp"
            android:textColor="#8490A5"
            android:layout_marginTop="20dp" />

        <TextView
            android:id="@+id/tvChiTietHangXe"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Toyota"
            android:textSize="16sp"
            android:textColor="#243B63"
            android:textStyle="bold"
            android:layout_marginTop="5dp" />

        <!-- BIỂN SỐ -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Biển số xe"
            android:textSize="13sp"
            android:textColor="#8490A5"
            android:layout_marginTop="16dp" />

        <TextView
            android:id="@+id/tvChiTietBienSo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="99A-123.45"
            android:textSize="16sp"
            android:textColor="#243B63"
            android:textStyle="bold"
            android:layout_marginTop="5dp" />

        <!-- NĂM SẢN XUẤT -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Năm sản xuất"
            android:textSize="13sp"
            android:textColor="#8490A5"
            android:layout_marginTop="16dp" />

        <TextView
            android:id="@+id/tvChiTietNamXe"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="2022"
            android:textSize="16sp"
            android:textColor="#243B63"
            android:textStyle="bold"
            android:layout_marginTop="5dp" />

        <!-- NÚT CHỈNH SỬA -->
        <Button
            android:id="@+id/btnSuaChiTietXe"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="28dp"
            android:text="✎  Chỉnh sửa thông tin"
            android:textAllCaps="false"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#1565C0" />

        <!-- NÚT XÓA -->
        <Button
            android:id="@+id/btnXoaChiTietXe"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:text="Xóa phương tiện"
            android:textAllCaps="false"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#C62828"
            android:backgroundTint="#FFEBEE" />

        <!-- ĐÓNG -->
        <TextView
            android:id="@+id/btnDongChiTietXe"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Đóng"
            android:textSize="15sp"
            android:textColor="#64748B"
            android:gravity="center"
            android:padding="14dp"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginTop="8dp" />

    </LinearLayout>

</ScrollView>