<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_daily_card"
    android:padding="14dp"
    android:layout_marginBottom="10dp">

    <TextView
        android:id="@+id/tvTenGara"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="AutoCare - Gara chính"
        android:textColor="#123B92"
        android:textStyle="bold"
        android:textSize="17sp" />

    <TextView
        android:id="@+id/tvDiaChiGara"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Địa chỉ gara"
        android:textColor="#596579"
        android:textSize="13sp"
        android:layout_marginTop="7dp" />

    <TextView
        android:id="@+id/tvGioMoCuaGara"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Giờ mở cửa"
        android:textColor="#596579"
        android:textSize="13sp"
        android:layout_marginTop="5dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="14dp">

        <Button
            android:id="@+id/btnGoiGara"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="Gọi điện"
            android:textAllCaps="false"
            android:textColor="#123B92"
            android:backgroundTint="#E6EEFF" />

        <Button
            android:id="@+id/btnChiDuongGara"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:text="Chỉ đường"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:backgroundTint="#123B92" />

    </LinearLayout>

</LinearLayout>
