<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F7FB">

    <!-- HEADER -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#123B92"
        android:padding="18dp">

        <TextView
            android:id="@+id/btnQuayLaiDaiLy"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="‹  Quay lại"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:paddingBottom="14dp"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Đại lý AutoCare"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="25sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tìm gara và xem đường đi dễ dàng"
            android:textColor="#D9E7FF"
            android:textSize="13sp"
            android:layout_marginTop="5dp" />

        <EditText
            android:id="@+id/edtTimGara"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_daily_search"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:hint="Tìm tên gara hoặc địa chỉ..."
            android:singleLine="true"
            android:inputType="text"
            android:textSize="14sp"
            android:textColor="#172554"
            android:textColorHint="#8A94A6" />

    </LinearLayout>

    <!-- BẢN ĐỒ -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_margin="12dp">

        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/mapGara"
            android:name="com.google.android.gms.maps.SupportMapFragment"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

    </FrameLayout>

    <!-- DANH SÁCH GARA -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#FFFFFF"
        android:padding="16dp"
        android:elevation="8dp">

        <TextView
            android:id="@+id/tvSoLuongGara"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Gara AutoCare"
            android:textStyle="bold"
            android:textColor="#14264B"
            android:textSize="18sp"
            android:layout_marginBottom="12dp" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fillViewport="false">

            <LinearLayout
                android:id="@+id/layoutDanhSachGara"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

        </ScrollView>

    </LinearLayout>

</LinearLayout>
