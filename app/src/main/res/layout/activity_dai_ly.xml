<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F7FB">

    <!-- HEADER -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#123B92"
        android:padding="18dp">

        <TextView
            android:id="@+id/btnQuayLaiDaiLy"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="‹  Quay lại"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:paddingBottom="14dp"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Đại lý AutoCare"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="25sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Thông tin gara và hỗ trợ chỉ đường"
            android:textColor="#D9E7FF"
            android:textSize="13sp"
            android:layout_marginTop="5dp" />

        <EditText
            android:id="@+id/edtTimGara"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_daily_search"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:hint="Tìm tên gara hoặc địa chỉ..."
            android:singleLine="true"
            android:inputType="text"
            android:textSize="14sp"
            android:textColor="#172554"
            android:textColorHint="#8A94A6" />

    </LinearLayout>

    <!-- NỘI DUNG CÓ THỂ CUỘN -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- THẺ GIỚI THIỆU GARA -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#FFFFFF"
                android:elevation="4dp">

                <!-- ẢNH GARA -->
                <ImageView
                    android:id="@+id/imgDaiLy"
                    android:layout_width="match_parent"
                    android:layout_height="210dp"
                    android:src="@drawable/imgdaily"
                    android:scaleType="centerCrop"
                    android:contentDescription="Hình ảnh gara AutoCare" />

                <!-- THÔNG TIN GARA -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Gara ô tô Xuân Đài"
                        android:textColor="#14264B"
                        android:textSize="21sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="📍 Phố Xuân Đài, Từ Sơn, Bắc Ninh"
                        android:textColor="#54657D"
                        android:textSize="14sp"
                        android:layout_marginTop="10dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="🕒 Mở cửa cả ngày"
                        android:textColor="#2E7D32"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:layout_marginTop="8dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="☎ 0564122122"
                        android:textColor="#54657D"
                        android:textSize="14sp"
                        android:layout_marginTop="8dp" />

                    <!-- NÚT GOOGLE MAPS -->
                    <Button
                        android:id="@+id/btnMoGoogleMaps"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginTop="18dp"
                        android:text="📍 Xem vị trí trên Google Maps"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:textSize="14sp"
                        android:backgroundTint="#1565C0" />

                </LinearLayout>

            </LinearLayout>

            <!-- DANH SÁCH GARA -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="20dp"
                android:padding="16dp"
                android:background="#FFFFFF"
                android:elevation="3dp">

                <TextView
                    android:id="@+id/tvSoLuongGara"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Gara AutoCare"
                    android:textStyle="bold"
                    android:textColor="#14264B"
                    android:textSize="18sp"
                    android:layout_marginBottom="12dp" />

                <LinearLayout
                    android:id="@+id/layoutDanhSachGara"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

    <!-- THANH ĐIỀU HƯỚNG CỐ ĐỊNH -->
    <include
        layout="@layout/layout_bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

</LinearLayout>