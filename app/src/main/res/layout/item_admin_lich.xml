<?xml version="1.0" encoding="utf-8"?>

<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="3dp"
    app:cardBackgroundColor="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- ========================= -->
        <!-- DỊCH VỤ -->
        <!-- ========================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:gravity="center"
                android:text="🔧"
                android:textSize="18sp"
                android:background="#E3F2FD"/>

            <TextView
                android:id="@+id/txtAdminTenDichVu"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:text="Dịch vụ: Đang tải..."
                android:textColor="#1565C0"
                android:textSize="16sp"
                android:textStyle="bold"/>

        </LinearLayout>


        <!-- ========================= -->
        <!-- ĐƯỜNG KẺ -->
        <!-- ========================= -->

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp"
            android:background="#E5E7EB"/>


        <!-- ========================= -->
        <!-- KHÁCH HÀNG -->
        <!-- ========================= -->

        <TextView
            android:id="@+id/txtAdminKhachHang"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Khách hàng: Đang tải..."
            android:textColor="#374151"
            android:textSize="14sp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"/>


        <!-- ========================= -->
        <!-- XE -->
        <!-- ========================= -->

        <TextView
            android:id="@+id/txtAdminXe"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Xe: Đang tải..."
            android:textColor="#374151"
            android:textSize="14sp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"/>


        <!-- ========================= -->
        <!-- NGÀY -->
        <!-- ========================= -->

        <TextView
            android:id="@+id/txtAdminNgay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📅 Ngày"
            android:textColor="#374151"
            android:textSize="14sp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"/>


        <!-- ========================= -->
        <!-- GIỜ -->
        <!-- ========================= -->

        <TextView
            android:id="@+id/txtAdminGio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🕐 Giờ"
            android:textColor="#374151"
            android:textSize="14sp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"/>


        <!-- ========================= -->
        <!-- GHI CHÚ -->
        <!-- ========================= -->

        <TextView
            android:id="@+id/txtAdminGhiChu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ghi chú: Không có"
            android:textColor="#6B7280"
            android:textSize="14sp"
            android:paddingTop="4dp"
            android:paddingBottom="8dp"/>


        <!-- ========================= -->
        <!-- TRẠNG THÁI -->
        <!-- ========================= -->

        <TextView
            android:id="@+id/txtAdminTrangThai"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CHỜ XÁC NHẬN"
            android:textColor="#F57C00"
            android:textSize="12sp"
            android:textStyle="bold"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="7dp"
            android:paddingBottom="7dp"
            android:background="#FFF3E0"/>


        <!-- ========================= -->
        <!-- KHU VỰC NÚT -->
        <!-- ========================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="14dp">

            <Button
                android:id="@+id/btnXacNhanLich"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="✓  Xác nhận"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:backgroundTint="#1565C0"
                android:minHeight="0dp"
                android:minWidth="0dp"/>

            <Space
                android:layout_width="10dp"
                android:layout_height="1dp"/>

            <Button
                android:id="@+id/btnCapNhatTrangThai"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="Cập nhật"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#1565C0"
                android:backgroundTint="#E3F2FD"
                android:minHeight="0dp"
                android:minWidth="0dp"/>

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>