<?xml version="1.0" encoding="utf-8"?>

<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="3dp"
    app:cardBackgroundColor="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <!-- DỊCH VỤ -->

        <TextView
            android:id="@+id/txtAdminTenDichVu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Thay dầu nhớt"
            android:textColor="#1F2937"
            android:textSize="18sp"
            android:textStyle="bold"/>


        <!-- KHÁCH HÀNG -->

        <TextView
            android:id="@+id/txtAdminKhachHang"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Khách hàng: Nguyễn Văn A"
            android:textColor="#4B5563"
            android:textSize="14sp"
            android:layout_marginTop="10dp"/>


        <!-- XE -->

        <TextView
            android:id="@+id/txtAdminXe"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Xe: Honda Wave - 99A1-12345"
            android:textColor="#4B5563"
            android:textSize="14sp"
            android:layout_marginTop="6dp"/>


        <!-- NGÀY -->

        <TextView
            android:id="@+id/txtAdminNgay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📅 Ngày: 24/9/2026"
            android:textColor="#4B5563"
            android:textSize="14sp"
            android:layout_marginTop="6dp"/>


        <!-- GIỜ -->

        <TextView
            android:id="@+id/txtAdminGio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🕐 Giờ: 18:45"
            android:textColor="#4B5563"
            android:textSize="14sp"
            android:layout_marginTop="6dp"/>


        <!-- GHI CHÚ -->

        <TextView
            android:id="@+id/txtAdminGhiChu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ghi chú: Thay lốp"
            android:textColor="#6B7280"
            android:textSize="14sp"
            android:layout_marginTop="6dp"/>


        <!-- TRẠNG THÁI -->

        <TextView
            android:id="@+id/txtAdminTrangThai"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CHỜ XÁC NHẬN"
            android:textColor="#F57C00"
            android:textSize="13sp"
            android:textStyle="bold"
            android:background="#FFF3E0"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:layout_marginTop="12dp"/>


        <!-- CÁC NÚT XỬ LÝ -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end"
            android:layout_marginTop="16dp">

            <Button
                android:id="@+id/btnXacNhanLich"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:text="Xác nhận"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:backgroundTint="#1565C0"
                android:layout_marginEnd="8dp"/>

            <Button
                android:id="@+id/btnCapNhatTrangThai"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:text="Cập nhật"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:backgroundTint="#2E7D32"/>

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>